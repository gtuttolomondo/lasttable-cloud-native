FROM docker.io/library/python@sha256:0f086103b026048cc50cb5da25ec435c023c5241a83fc44daea593377abc61c4
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY app/requirements.lock.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
ENV PYTHONPATH=/app
COPY app/lasttable/ lasttable/
USER 65532:65532
EXPOSE 8000
CMD ["uvicorn", "lasttable.api:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
