FROM node:24-alpine AS build
WORKDIR /build
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --ignore-scripts
COPY frontend/index.html frontend/vite.config.js ./
COPY frontend/src/ src/
RUN npm run build
FROM caddy:2.11.7-alpine
COPY --from=build /build/dist/ /srv/
COPY frontend/Caddyfile /etc/caddy/Caddyfile.base
COPY frontend/Caddyfile.https /etc/caddy/Caddyfile.https
RUN setcap -r /usr/bin/caddy && mkdir -p /data/caddy /config/caddy && chown -R 65532:65532 /data /config
USER 65532:65532
EXPOSE 8080 8443
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile.https", "--adapter", "caddyfile"]
